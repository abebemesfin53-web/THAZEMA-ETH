# Thazema Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database
MONGODB_URI=mongodb://localhost:27017/thazema
# Or use MongoDB Atlas for cloud database:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/thazema

# SMS Configuration (Choose one provider)
SMS_PROVIDER=twilio
# Options: twilio, africastalking, ethiopian

# Twilio SMS (https://www.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Africa's Talking (Great for Ethiopia!) (https://africastalking.com)
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=your_africastalking_username

# Ethiopian SMS Gateway (Custom)
ETHIOPIAN_SMS_API_URL=https://your-ethiopian-sms-gateway.com/api/send
ETHIOPIAN_SMS_API_KEY=your_ethiopian_sms_api_key

# WhatsApp Business API (https://business.whatsapp.com)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Public Server URL (for production deployment)
PUBLIC_URL=https://your-domain.com
# Or use your server IP:
# PUBLIC_URL=http://your-server-ip:5000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# File Upload
MAX_FILE_SIZE=10485760
# 10MB in bytes

# Session
SESSION_SECRET=your-session-secret-key

# Email (Optional - for email notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# Redis (Optional - for caching and sessions)
REDIS_URL=redis://localhost:6379

# Deployment Platform Specific

# Railway.app
# RAILWAY_STATIC_URL will be set automatically

# Heroku
# DATABASE_URL will be set automatically

# Render.com
# Will use environment variables from dashboard

# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=thazema-uploads

# Feature Flags
ENABLE_SMS=true
ENABLE_WHATSAPP=true
ENABLE_EMAIL=false
ENABLE_PUSH_NOTIFICATIONS=false
